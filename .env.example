# Скопіюйте у .env і підставте свої значення.
# Локально підійде будь-який Postgres; на проді це рядок підключення від Neon.
DATABASE_URL=postgresql://postgres:пароль@localhost:5432/tramline

# Без нього сервер не стартує: цим ключем підписуються сесії.
JWT_SECRET=згенеруйте_довгий_випадковий_рядок

PORT=3002
