{
  "name": "tramline-calc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Розрахунок технологічної колії: які висівні секції вимикати і на якому проході",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:render": "vite build --ssr test/ssr-entry.jsx --outDir .ssr-tmp --emptyOutDir --logLevel warn && node .ssr-tmp/ssr-entry.js",
    "test:text": "vite build --ssr test/ssr-text.jsx --outDir .ssr-tmp2 --emptyOutDir --logLevel warn && node .ssr-tmp2/ssr-text.js",
    "test:css": "node test/css-cover.mjs",
    "test:contrast": "node test/contrast.mjs",
    "test:speed": "node test/speed.mjs",
    "test:server": "node --test test/server.mjs",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
